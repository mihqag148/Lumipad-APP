                                    </StackPanel>

                                    <StackPanel x:Name="PixelHardwareInfoPanel"
                                                Visibility="Collapsed">
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Flash usage"/>
                                            <TextBlock x:Name="FlashUsageText"
                                                       Grid.Column="1"
                                                       Text="FLASH --"
                                                       Foreground="{DynamicResource Muted}"/>
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="SRAM usage"/>
                                            <TextBlock x:Name="SramUsageText"
                                                       Grid.Column="1"
                                                       Text="SRAM --"
                                                       Foreground="{DynamicResource Muted}"/>
                                        </Grid>

                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="PSRAM usage"/>
                                            <TextBlock x:Name="PsramUsageText"
                                                       Grid.Column="1"
                                                       Text="PSRAM --"
                                                       Foreground="{DynamicResource Muted}"/>
                                        </Grid>

                                        <TextBlock Text="Display"
                                                   Foreground="{DynamicResource Muted}"
                                                   Margin="0,18,0,6"/>
                                        <Border Background="{DynamicResource ControlBg}"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="10">
                                            <TextBlock x:Name="PanelInfoText"
                                                       Text="ILI9486 · 480×320 · i8080 8-bit · GIF max 60 FPS"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Diagnostic log"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,18,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ViewLogButton"
                                                Content="View log"
                                                Click="ToggleLog_Click"/>
                                        <Button Content="Save log"
                                                Click="SaveLog_Click"
                                                Margin="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="20"
                                    Padding="22">
                                <StackPanel>
                                    <TextBlock Text="SHOP &amp; SUPPORT"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Text="Lumi3D"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Phone"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="096 527 6752"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Shopee"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <Button Grid.Column="1"
                                                Content="shopee.vn/lumi3d.hn"
                                                Click="OpenShopee_Click"
                                                HorizontalAlignment="Left"
                                                Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>


        </Grid>

        <Grid x:Name="ProductHub"
              Background="{DynamicResource Bg}">
            <Grid Margin="34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Lumi Macropad"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Choose a product"
                                       Foreground="{DynamicResource Muted}"
                                       FontSize="13"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock x:Name="ProductHubVersionText"
                                   Text="v--"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="12"/>
                        <TextBlock Text="Product Hub"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Muted}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="ProductCardsPanel"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </ScrollViewer>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProductHubStatusText"
                               Text="Searching for Lumi devices…"
                               Foreground="{DynamicResource Muted}"
                               FontSize="12"/>
                    <TextBlock Grid.Column="1"
                               Text="Lumi3D · Multi-product device manager"
                               Foreground="{DynamicResource Muted}"
                               FontSize="11"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
