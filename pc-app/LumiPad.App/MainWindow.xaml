<Window x:Class="LumiPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lumi Macropad" Width="1480" Height="960"
        MinWidth="1080" MinHeight="720"
        Background="{DynamicResource Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="{x:Type ToolTip}">
            <Setter Property="Foreground" Value="#F5F5F7"/>
            <Setter Property="Background" Value="#252527"/>
            <Setter Property="BorderBrush" Value="#4A4A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="#252527"
                                BorderBrush="#4A4A4D"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,5">
                            <ContentPresenter
                                TextElement.Foreground="#F5F5F7"
                                TextElement.FontFamily="Segoe UI"
                                TextElement.FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid x:Name="DeviceWorkspace"
              Margin="24"
              Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="← Products"
                        Click="BackToProducts_Click"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="WorkspaceProductTitle"
                               Text="RYNOR ONE"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Lumi Macropad · Device Control"
                               Foreground="{DynamicResource Muted}"
                               FontSize="13"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                <Button x:Name="SleepKeyboardButton"
                        Width="38" Height="38"
                        Padding="0"
                        ToolTip="Sleep keyboard"
                        Click="SleepKeyboard_Click"
                        IsEnabled="False"
                        Margin="0">
                    <TextBlock x:Name="SleepKeyboardIcon"
                               Text="⏻"
                               FontFamily="Segoe UI Symbol"
                               FontSize="19"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Button>

                <Button x:Name="ConnectUsbButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="USB"
                        Click="ConnectUsbButton_Click"
                        Margin="22,0,8,0">
                    <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="HeaderUsbPath"
                                  Stroke="{DynamicResource Muted}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M12,3 L12,16 M12,3 L9,6 M12,3 L15,6 M12,10 L7,10 L7,16 M7,16 L5,16 M12,13 L17,13 L17,9 M17,9 L15,11 M17,9 L19,11"/>
                            <Ellipse x:Name="HeaderUsbDot"
                                     Canvas.Left="10" Canvas.Top="16"
                                     Width="4" Height="4"
                                     Fill="{DynamicResource Muted}"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button x:Name="ConnectBluetoothButton"
                        Width="38" Height="38"
                        Padding="8"
                        ToolTip="Bluetooth"
                        Click="ConnectBluetoothButton_Click"
                        Margin="0">
                    <Viewbox Width="20" Height="20">
                        <Path x:Name="HeaderBluetoothPath"
                              Stroke="{DynamicResource Muted}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M11,3 L17,8 L11,13 L11,3 M11,13 L17,18 L11,22 L11,13 M11,8 L6,4 M11,17 L6,21"/>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="2"
                    SelectionChanged="MainTabs_SelectionChanged">

            <TabItem Header="Home">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="28"
                            Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="MEDIA"
                                           FontSize="12"
                                           Foreground="{DynamicResource Muted}"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="SourceText"
                                           Text="MEDIA SESSION"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Foreground="{DynamicResource Muted}"/>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="138"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Border Width="138"
                                        Height="138"
                                        CornerRadius="18"
                                        Background="{DynamicResource Card2}"
                                        BorderBrush="{DynamicResource Line}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <Image x:Name="AlbumArtImage"
                                               Stretch="UniformToFill"
                                               Visibility="Collapsed"/>
                                        <Grid x:Name="AlbumArtFallback">
                                            <Ellipse Width="66" Height="66">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0"
                                                                         EndPoint="1,1">
                                                        <GradientStop Color="#FF9500" Offset="0"/>
                                                        <GradientStop Color="#FF2D55" Offset="0.55"/>
                                                        <GradientStop Color="#5856D6" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="▶"
                                                       FontSize="24"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="2"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Text="Nothing Playing"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               MaxHeight="66"/>
                                    <TextBlock x:Name="ArtistText"
                                               Text="Lumi Macropad"
                                               FontSize="14"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,5,0,17"/>

                                    <Slider x:Name="TrackSlider"
                                            Minimum="0"
                                            Maximum="1"
                                            Value="0"
                                            Height="24"
                                            IsMoveToPointEnabled="True"
                                            IsEnabled="False"
                                            PreviewMouseLeftButtonDown="TrackSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="TrackSlider_PreviewMouseLeftButtonUp"
                                            ValueChanged="TrackSlider_ValueChanged"/>

                                    <Grid Margin="1,2,1,0">
                                        <TextBlock x:Name="ElapsedText"
                                                   Text="0:00"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="DurationText"
                                                   Text="-0:00"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="MuteButton"
                                            Content="🔊"
                                            Width="38"
                                            Height="38"
                                            Padding="0"
                                            Click="MuteButton_Click"
                                            ToolTip="Mute / unmute"/>
                                    <Slider x:Name="VolumeSlider"
                                            Width="112"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="50"
                                            IsMoveToPointEnabled="True"
                                            VerticalAlignment="Center"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                    <TextBlock x:Name="VolumeText"
                                               Text="50%"
                                               Width="40"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="11"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <Button x:Name="PrevButton"
                                            Content="◀◀"
                                            Width="42"
                                            Height="38"
                                            Padding="0"
                                            IsEnabled="False"
                                            Click="PrevButton_Click"/>
                                    <Button x:Name="PlayButton"
                                            Content="▶"
                                            Width="48"
                                            Height="42"
                                            Padding="0"
                                            FontSize="17"
                                            IsEnabled="False"
                                            Click="PlayButton_Click"/>
                                    <Button x:Name="NextButton"
                                            Content="▶▶"
                                            Width="42"
                                            Height="38"
                                            Padding="0"
                                            Margin="0"
                                            IsEnabled="False"
                                            Click="NextButton_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ShuffleButton"
                                            Content="🔀"
                                            Width="40"
                                            Height="38"
                                            Padding="0"
                                            IsEnabled="False"
                                            Click="ShuffleButton_Click"
                                            ToolTip="Shuffle"/>
                                    <Button x:Name="RepeatButton"
                                            Content="↻"
                                            Width="48"
                                            Height="38"
                                            Padding="0"
                                            Margin="0"
                                            IsEnabled="False"
                                            Click="RepeatButton_Click"
                                            ToolTip="Repeat"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                            CornerRadius="28" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,6,0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SCREENSAVER MEDIA"
                                               FontSize="12"
                                               Foreground="{DynamicResource Muted}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="GIF / Image local"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Margin="0,7,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="Source"
                                               FontSize="11"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ScreensaverSourceCombo"
                                              Width="170"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="ScreensaverSourceCombo_SelectionChanged">
                                        <ComboBoxItem Content="GIF / Image" Tag="Media" IsSelected="True"/>
                                        <ComboBoxItem Content="PC Monitor" Tag="PcMonitor"/>
                                    </ComboBox>
                                    <TextBlock x:Name="ScreensaverSourceHint"
                                               Text="Uploaded media"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- RYNOR ONE remains 320x172. PIXEL PRO switches this
                                 named preview to the ILI9486 landscape 480x320 3:2
                                 aspect ratio at runtime. -->
                            <Border x:Name="ScreensaverPreviewBorder"
                                    Width="360"
                                    Height="193.5"
                                    HorizontalAlignment="Center"
                                    Background="#050505"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Grid x:Name="ScreensaverPreviewSurface"
                                      Width="320"
                                      Height="172">
                                    <Image x:Name="ScreensaverPreviewImage"
                                           Stretch="Fill"
                                           Visibility="Collapsed"/>
                                    <TextBlock x:Name="ScreensaverPreviewHint"
                                               Text="320 × 172 · Choose a GIF or image"
                                               Foreground="{DynamicResource Muted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="ScreensaverFileName"
                                       Text="No file selected"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,10,0,0"/>

                            <TextBlock x:Name="ScreensaverMediaInfo"
                                       Text="Converted to a lightweight loop for RYNOR ONE."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,4,0,10"/>

                            <Border x:Name="PixelMediaSettingsPanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource ControlBg}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="PIXEL PRO · GIF"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Quality cap 2 MiB · priority: color depth → FPS → resolution · Delta + RLE"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,7"/>
                                        <TextBlock Text="RGB888 → RGB565 minimum · FPS 60 → 50 → 40 → 30 → 25 → 20 → 15… · 480×320 → 360×240 minimum"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox x:Name="PixelGifFpsCombo"
                                                  Visibility="Collapsed"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="PixelMediaSetting_SelectionChanged">
                                            <ComboBoxItem Content="Auto" Tag="60" IsSelected="True"/>
                                        </ComboBox>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Layout" Width="72" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PixelMediaScaleCombo"
                                                      Width="150"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="PixelMediaSetting_SelectionChanged">
                                                <ComboBoxItem Content="Fill" Tag="Fill" IsSelected="True"/>
                                                <ComboBoxItem Content="Fit" Tag="Fit"/>
                                                <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                                                <ComboBoxItem Content="Tile" Tag="Tile"/>
                                                <ComboBoxItem Content="Center" Tag="Center"/>
                                                <ComboBoxItem Content="Span" Tag="Span"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,6,0,0"
                                                    Visibility="Collapsed">
                                            <TextBlock Text="Max time" Width="72" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="PixelGifDurationCombo"
                                                      Width="110"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="10 s" Tag="10" IsSelected="True"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PIXEL PRO · IMAGE"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Auto JPEG · quality 100 · 24-bit source → RGB565 panel"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,5"/>
                                        <TextBlock Text="Output 480×320 · uses the same Windows-style Fill / Fit / Stretch / Tile / Center / Span layout selector"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Muted}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <StackPanel x:Name="ScreensaverScalePanel"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,12">
                                <TextBlock Text="Scale"
                                           Width="52"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}"/>
                                <ComboBox x:Name="ScreensaverScaleCombo"
                                          Width="150"
                                          SelectionChanged="ScreensaverScaleCombo_SelectionChanged">
                                    <ComboBoxItem Content="Fill" Tag="Fill" IsSelected="True"/>
                                    <ComboBoxItem Content="Fit" Tag="Fit"/>
                                    <ComboBoxItem Content="Stretch" Tag="Stretch"/>
                                    <ComboBoxItem Content="Tile" Tag="Tile"/>
                                    <ComboBoxItem Content="Center" Tag="Center"/>
                                    <ComboBoxItem Content="Span" Tag="Span"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose GIF / Image"
                                        Click="ChooseScreensaverMedia_Click"/>
                                <Button x:Name="SendScreensaverButton"
                                        Content="Send to RYNOR ONE"
                                        Click="SendScreensaverMedia_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="ShowScreensaverNowButton"
                                        Content="Show now"
                                        Click="ShowScreensaverNow_Click"
                                        IsEnabled="False"/>
                                <Button Content="Clear"
                                        Click="ClearScreensaverMedia_Click"
                                        Margin="0"/>
                            </StackPanel>

                            <ProgressBar x:Name="ScreensaverSendProgress"
                                         Minimum="0" Maximum="100" Value="0"
                                         Height="5" Margin="0,14,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Ellipse x:Name="ScreensaverUploadDot"
                                         Width="9" Height="9"
                                         Fill="#66666A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,7,0"/>
                                <TextBlock x:Name="ScreensaverUploadState"
                                           Text="Not uploaded"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="ScreensaverSendStatus"
                                       Text="The file stays local. Only reduced animation frames are sent."
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Muted}"
                                       Margin="0,8,0,0"/>

                            <Border Height="1"
                                    Background="{DynamicResource Line}"
                                    Margin="0,14,0,12"/>

                            <Grid x:Name="DeviceTimingPanel" IsEnabled="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Screensaver after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="ScreensaverDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="ScreensaverDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sleep after"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="SleepDelayCombo"
                                              SelectedValuePath="Tag"
                                              SelectionChanged="SleepDelayCombo_SelectionChanged">
                                        <ComboBoxItem Content="1 minute" Tag="60"/>
                                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                                        <ComboBoxItem Content="15 minutes" Tag="900"/>
                                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                                        <ComboBoxItem Content="Never" Tag="0"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>



                </Grid>
            </TabItem>

            <TabItem x:Name="ConfiguratorTab" Header="Device Config">
                <Grid Margin="0,14,0,0">
                    <Grid x:Name="RynorConfiguratorPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource Card2}"
                                BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                CornerRadius="18" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="DeviceConfiguratorTitle"
                                               Text="Device Config"
                                               FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock x:Name="ConfiguratorStatus"
                                               Text="Embedded device configurator"
                                               Foreground="{DynamicResource Muted}"
                                               FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Reload" Click="ReloadConfigurator_Click"/>
                                    <Button Content="Open in Edge"
                                            Click="OpenConfiguratorExternal_Click" Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Background="White"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1" CornerRadius="18"
                                ClipToBounds="True">
                            <wv2:WebView2 x:Name="ConfiguratorWebView"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="PixelProKeymapPanel"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="PIXEL PRO · KEYMAP"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Configure"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="VIA-style live keymap editor"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="12"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom">
                                <Button Content="Import"
                                        Click="PixelKeymapImport_Click"/>
                                <Button Content="Export"
                                        Click="PixelKeymapExport_Click"/>
                                <Button Content="Reset"
                                        ToolTip="Reset current profile to default"
                                        Click="PixelKeymapReset_Click"
                                        Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2"
                                Background="#101114"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PROFILE"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <Grid Width="200"
                                              Margin="0,0,6,0">
                                            <ComboBox x:Name="PixelProfileCombo"
                                                      IsEditable="False"
                                                      MaxDropDownHeight="360"
                                                      ToolTip="Select profile"
                                                      SelectionChanged="PixelProfileCombo_SelectionChanged"/>
                                            <TextBox x:Name="PixelProfileRenameTextBox"
                                                     Visibility="Collapsed"
                                                     VerticalContentAlignment="Center"
                                                     MaxLength="32"
                                                     ToolTip="Rename current profile"
                                                     KeyDown="PixelProfileRenameTextBox_KeyDown"
                                                     LostKeyboardFocus="PixelProfileRenameTextBox_LostKeyboardFocus"/>
                                        </Grid>
                                        <Button Content="✎"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTip="Rename current profile"
                                                Click="PixelRenameProfile_Click"
                                                Margin="0,0,4,0"/>
                                        <Button Content="+"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTip="Add profile"
                                                Click="PixelAddProfile_Click"
                                                Margin="0,0,4,0"/>
                                        <Button Content="−"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                ToolTip="Delete current profile"
                                                Click="PixelRemoveProfile_Click"
                                                Margin="0,0,18,0"/>
                                        <TextBlock Text="LAYER"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <Button x:Name="PixelLayer0Button" Content="0" Tag="0"
                                                Width="38" Height="32" Padding="0"
                                                Click="PixelLayerButton_Click"/>
                                        <Button x:Name="PixelLayer1Button" Content="1" Tag="1"
                                                Width="38" Height="32" Padding="0"
                                                Click="PixelLayerButton_Click"/>
                                        <Button x:Name="PixelLayer2Button" Content="2" Tag="2"
                                                Width="38" Height="32" Padding="0"
                                                Click="PixelLayerButton_Click"/>
                                        <Button x:Name="PixelLayer3Button" Content="3" Tag="3"
                                                Width="38" Height="32" Padding="0"
                                                Click="PixelLayerButton_Click"/>
                                    </StackPanel>

                                    <CheckBox x:Name="PixelMatrixTestCheckBox"
                                              Content="Test Matrix"
                                              IsChecked="True"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <UniformGrid x:Name="PixelViaKeyboardGrid"
                                             Grid.Row="2"
                                             Rows="2"
                                             Columns="4"
                                             HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="10">
                                <ListBox x:Name="PixelKeyCategoryList"
                                         SelectionChanged="PixelKeyCategoryList_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         SelectedIndex="0">
                                    <ListBoxItem Content="Basic" Tag="Basic"/>
                                    <ListBoxItem Content="Media" Tag="Media"/>
                                    <ListBoxItem Content="Modifiers" Tag="Modifiers"/>
                                    <ListBoxItem Content="Layers" Tag="Layers"/>
                                    <ListBoxItem Content="Macro" Tag="Macro"/>
                                    <ListBoxItem Content="Action" Tag="Action"/>
                                    <ListBoxItem Content="Special" Tag="Special"/>
                                </ListBox>
                            </Border>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock x:Name="PixelPaletteTitleText"
                                                   Text="BASIC"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Text="Select a keycode"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="2"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <WrapPanel x:Name="PixelKeyPalettePanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4"
                                    Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="SELECTED KEY"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"/>
                                        <TextBlock x:Name="PixelSelectedKeyTitle"
                                                   Text="K1"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock x:Name="PixelSelectedBindingText"
                                                   Text="A"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource Muted}"
                                                   Margin="0,2,0,14"/>

                                        <TextBlock Text="MODIFIERS · drag the ⋮ handles to reorder"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Muted}"/>

                                        <Border x:Name="PixelModifiersPanel"
                                                Margin="0,6,0,10"
                                                Background="{DynamicResource Card2}"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="9">
                                            <StackPanel>
                                                <TextBlock Text="Order is visual; checked modifiers are sent together."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Muted}"
                                                           Margin="0,0,0,8"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel x:Name="PixelModifierOrderPanel"
                                                            Orientation="Horizontal">
                                                    <Border x:Name="PixelModifierCtrlCard"
                                                            Tag="Ctrl"
                                                            Background="{DynamicResource ControlBg}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="5"
                                                            Margin="0,0,5,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⋮"
                                                                       Tag="Ctrl"
                                                                       Cursor="SizeWE"
                                                                       FontSize="15"
                                                                       Margin="0,0,3,0"
                                                                       PreviewMouseLeftButtonDown="PixelModifierHandle_PreviewMouseLeftButtonDown"
                                                                       PreviewMouseMove="PixelModifierHandle_PreviewMouseMove"
                                                                       PreviewMouseLeftButtonUp="PixelModifierHandle_PreviewMouseLeftButtonUp"/>
                                                            <CheckBox x:Name="PixelSelectedCtrl"
                                                                      Content="Ctrl"
                                                                      Checked="PixelSelectedModifier_Changed"
                                                                      Unchecked="PixelSelectedModifier_Changed"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="PixelModifierShiftCard"
                                                            Tag="Shift"
                                                            Background="{DynamicResource ControlBg}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="5"
                                                            Margin="0,0,5,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⋮"
                                                                       Tag="Shift"
                                                                       Cursor="SizeWE"
                                                                       FontSize="15"
                                                                       Margin="0,0,3,0"
                                                                       PreviewMouseLeftButtonDown="PixelModifierHandle_PreviewMouseLeftButtonDown"
                                                                       PreviewMouseMove="PixelModifierHandle_PreviewMouseMove"
                                                                       PreviewMouseLeftButtonUp="PixelModifierHandle_PreviewMouseLeftButtonUp"/>
                                                            <CheckBox x:Name="PixelSelectedShift"
                                                                      Content="Shift"
                                                                      Checked="PixelSelectedModifier_Changed"
                                                                      Unchecked="PixelSelectedModifier_Changed"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="PixelModifierAltCard"
                                                            Tag="Alt"
                                                            Background="{DynamicResource ControlBg}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="5"
                                                            Margin="0,0,5,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⋮"
                                                                       Tag="Alt"
                                                                       Cursor="SizeWE"
                                                                       FontSize="15"
                                                                       Margin="0,0,3,0"
                                                                       PreviewMouseLeftButtonDown="PixelModifierHandle_PreviewMouseLeftButtonDown"
                                                                       PreviewMouseMove="PixelModifierHandle_PreviewMouseMove"
                                                                       PreviewMouseLeftButtonUp="PixelModifierHandle_PreviewMouseLeftButtonUp"/>
                                                            <CheckBox x:Name="PixelSelectedAlt"
                                                                      Content="Alt"
                                                                      Checked="PixelSelectedModifier_Changed"
                                                                      Unchecked="PixelSelectedModifier_Changed"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="PixelModifierWinCard"
                                                            Tag="Win"
                                                            Background="{DynamicResource ControlBg}"
                                                            BorderBrush="{DynamicResource Line}"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⋮"
                                                                       Tag="Win"
                                                                       Cursor="SizeWE"
                                                                       FontSize="15"
                                                                       Margin="0,0,3,0"
                                                                       PreviewMouseLeftButtonDown="PixelModifierHandle_PreviewMouseLeftButtonDown"
                                                                       PreviewMouseMove="PixelModifierHandle_PreviewMouseMove"
                                                                       PreviewMouseLeftButtonUp="PixelModifierHandle_PreviewMouseLeftButtonUp"/>
                                                            <CheckBox x:Name="PixelSelectedWin"
                                                                      Content="Win"
                                                                      Checked="PixelSelectedModifier_Changed"
                                                                      Unchecked="PixelSelectedModifier_Changed"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Height="1"
                                                Background="{DynamicResource Line}"
                                                Margin="0,0,0,14"/>

                                        <TextBlock Text="Assign a Macro or Lumi Action here. Edit Macro and Action contents in their own tabs."
                                                   Foreground="{DynamicResource Muted}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PixelKeymapStatusText"
                                       Text="Connect PIXEL PRO to load the keymap."
                                       Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="PixelKeymapSaveButton"
                                    Grid.Column="1"
                                    Content="Save to PIXEL PRO"
                                    Click="PixelKeymapSave_Click"
                                    IsEnabled="False"
                                    Margin="0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>


            <TabItem x:Name="PixelMacroTab" Header="Macro" Visibility="Collapsed">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="285"/>
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="MACROS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Muted}"/>

                            <ListBox x:Name="PixelMacroList"
                                     Grid.Row="2"
                                     SelectionChanged="PixelMacroList_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Padding="4,2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBox x:Name="PixelMacroNameTextBox"
                                             Text="Macro 1"
                                             FontSize="21"
                                             FontWeight="SemiBold"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Width="260"
                                             HorizontalAlignment="Left"
                                             LostFocus="PixelMacroNameTextBox_LostFocus"/>
                                    <TextBlock x:Name="PixelMacroTitleText"
                                               Text="M1"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="Test"
                                            Click="PixelMacroTest_Click"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Save"
                                            Click="PixelMacroSave_Click"
                                            Margin="0"/>
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="PixelMacroStepsList"
                                     Grid.Row="2"
                                     AllowDrop="True"
                                     PreviewMouseLeftButtonDown="PixelMacroStepsList_PreviewMouseLeftButtonDown"
                                     PreviewMouseMove="PixelMacroStepsList_PreviewMouseMove"
                                     DragOver="PixelMacroStepsList_DragOver"
                                     Drop="PixelMacroStepsList_Drop"
                                     BorderBrush="{DynamicResource Line}"
                                     BorderThickness="1"
                                     Background="{DynamicResource Card2}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Card}"
                                                BorderBrush="{DynamicResource Line}"
                                                BorderThickness="0,0,0,1"
                                                Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24"/>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="⋮⋮"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource Muted}"
                                                           FontSize="14"
                                                           ToolTip="Drag to reorder"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Type}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Muted}"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <Grid Grid.Column="2">
                                                    <TextBox x:Name="GenericStepValue"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             LostFocus="PixelMacroStepValue_LostFocus"
                                                             Padding="6,3"/>

                                                    <TextBlock x:Name="KeyDownGlyph"
                                                               Text="↓"
                                                               Visibility="Collapsed"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               FontSize="20"
                                                               FontWeight="Bold"/>

                                                    <StackPanel x:Name="DelayEditor"
                                                                Visibility="Collapsed"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                 LostFocus="PixelMacroStepValue_LostFocus"
                                                                 Width="68"
                                                                 Padding="5,2"
                                                                 TextAlignment="Center"/>
                                                        <TextBlock Text="ms"
                                                                   VerticalAlignment="Center"
                                                                   Margin="5,0,0,0"
                                                                   Foreground="{DynamicResource Muted}"/>
                                                    </StackPanel>

                                                    <TextBlock x:Name="KeyLabelText"
                                                               Text="{Binding Value}"
                                                               Visibility="Collapsed"
                                                               VerticalAlignment="Center"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"/>

                                                    <TextBlock x:Name="KeyUpGlyph"
                                                               Text="↑"
                                                               Visibility="Collapsed"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               FontSize="20"
                                                               FontWeight="Bold"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="KeyDown">
                                                <Setter TargetName="GenericStepValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="KeyDownGlyph" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Delay">
                                                <Setter TargetName="GenericStepValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="DelayEditor" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="KeyLabel">
                                                <Setter TargetName="GenericStepValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="KeyLabelText" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="KeyUp">
                                                <Setter TargetName="GenericStepValue" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="KeyUpGlyph" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Drag ⋮⋮ to reorder any step"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="10"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal">
                                    <Button Content="Delete"
                                            Click="PixelMacroStepDelete_Click"
                                            Margin="0,0,6,0"/>
                                    <Button Content="Clear all"
                                            ToolTip="Remove every step from this macro"
                                            Click="PixelMacroClearAll_Click"
                                            Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4"
                            Background="{DynamicResource Card}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="ADD STEP"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}"/>

                                <ComboBox x:Name="PixelMacroStepTypeCombo"
                                          SelectionChanged="PixelMacroStepTypeCombo_SelectionChanged"
                                          Margin="0,8,0,6">
                                    <ComboBoxItem Content="Action" Tag="Action"/>
                                    <ComboBoxItem Content="Key" Tag="Key"/>
                                    <ComboBoxItem Content="Combo Keys" Tag="Keys"/>
                                    <ComboBoxItem Content="Text" Tag="Text"/>
                                    <ComboBoxItem Content="Run App / File / URL" Tag="Run"/>
                                    <ComboBoxItem Content="Delay" Tag="Delay"/>
                                    <ComboBoxItem Content="Media" Tag="Media"/>
                                    <ComboBoxItem Content="Mouse Left Click" Tag="MouseClick:LEFT"/>
                                    <ComboBoxItem Content="Mouse Right Click" Tag="MouseClick:RIGHT"/>
                                    <ComboBoxItem Content="Mouse Middle Click" Tag="MouseClick:MIDDLE"/>
                                    <ComboBoxItem Content="Mouse Wheel" Tag="MouseWheel"/>
                                    <ComboBoxItem Content="Mouse Move" Tag="MouseMove"/>
                                </ComboBox>

                                <TextBlock x:Name="PixelMacroStepHintText"
                                           Text="Choose a step type."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>

                                <ComboBox x:Name="PixelMacroActionCombo"
                                          Visibility="Collapsed"
                                          Margin="0,0,0,6"/>

                                <TextBox x:Name="PixelMacroStepValueTextBox"
                                         Visibility="Collapsed"
                                         Margin="0,0,0,6"/>

                                <Grid x:Name="PixelMacroKeyInputPanel"
                                      Visibility="Collapsed"
                                      Margin="0,0,0,6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="PixelMacroKeyCaptureBox"
                                             Text="Click here, then press a key…"
                                             IsReadOnly="True"
                                             PreviewKeyDown="PixelMacroKeyCaptureBox_PreviewKeyDown"
                                             VerticalContentAlignment="Center"/>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal">
                                        <TextBlock Text="Delay"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>
                                        <TextBox x:Name="PixelMacroDefaultDelayTextBox"
                                                 Text="100"
                                                 Width="58"
                                                 MaxLength="6"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBlock Text="ms"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="PixelMacroAddStepButton"
                                        Content="Add"
                                        Click="PixelMacroAddStep_Click"
                                        Margin="0,0,0,10"/>

                                <TextBlock Text="QUICK"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Muted}"/>

                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Ctrl+C"
                                            Tag="Keys|Ctrl+C"
                                            Click="PixelMacroQuickStep_Click"
                                            Margin="0,0,5,5"/>
                                    <Button Content="Ctrl+V"
                                            Tag="Keys|Ctrl+V"
                                            Click="PixelMacroQuickStep_Click"
                                            Margin="0,0,5,5"/>
                                    <Button Content="Ctrl+Z"
                                            Tag="Keys|Ctrl+Z"
                                            Click="PixelMacroQuickStep_Click"
                                            Margin="0,0,5,5"/>
                                    <Button Content="100 ms"
                                            Tag="Delay|100"
                                            Click="PixelMacroQuickStep_Click"
                                            Margin="0,0,5,5"/>
                                    <Button Content="Left Click"
                                            Tag="MouseClick|LEFT"
                                            Click="PixelMacroQuickStep_Click"
                                            Margin="0,0,5,5"/>
                                </WrapPanel>

                                <TextBlock x:Name="PixelMacroStatusText"
                                           Text="Macros run through LumiPad on Windows."
                                           Foreground="{DynamicResource Muted}"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Action">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="ACTION / SCRIPT ENGINE"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="Lumi Action"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="LumiActionDescriptionText"
                                   Text="Create actions and assign them to RYNOR ONE keys."
                                   Foreground="{DynamicResource Muted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Scripts"
                                           FontSize="18"
                                           FontWeight="SemiBold"/>

                                <ListBox x:Name="ActionScriptsList"
                                         Grid.Row="2"
                                         SelectionChanged="ActionScriptsList_SelectionChanged"/>

                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal">
                                    <Button Content="New"
                                            Click="NewActionScript_Click"/>
                                    <Button Content="Delete"
                                            Click="DeleteActionScript_Click"
                                            Margin="0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Line}"
                                BorderThickness="1"
                                CornerRadius="20"
                                Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="SCRIPT EDITOR"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Muted}"/>
